# Copy to .env (gitignored) and fill in.
# On Streamlit Cloud, put the same keys in the app's Secrets panel (TOML: KEY = "value").
LLM_PROVIDER=groq            # primary provider
LLM_FALLBACK=groq,gemini     # tried in order if the primary fails; providers without a key are skipped
GROQ_API_KEY=                # free: https://console.groq.com/keys
GEMINI_API_KEY=              # free: https://aistudio.google.com/apikey

# Optional
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.6-flash
# MAX_SESSION_QUESTIONS=15
# MAX_DAILY_QUESTIONS=200
